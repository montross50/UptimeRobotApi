{
  "name": "montross50/uptime-robot-api",
  "type": "library",
  "description": "API wrapper for uptime robot",
  "keywords": [
    "montross50",
    "UptimeRobotApi"
  ],
  "homepage": "https://github.com/Montross50/UptimeRobotApi",
  "license": "MIT",
  "authors": [
    {
      "name": "Trent Schmidt",
      "email": "sch43228@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "jane-php/json-schema-runtime": "^7.14",
    "jane-php/open-api-runtime": "^7.14",
    "illuminate/support": "^8 || ^9 || ^10 || ^11 || ^12 || ^13",
    "php-http/discovery": "^1.10",
    "php-http/client-implementation": "^1.0",
    "php-http/message": "^1.9",
    "php-http/httplug": "^2"
  },
  "require-dev": {
    "jane-php/open-api-2": "^7.14",
    "phpunit/phpunit": "^9.5.10 || ^10 || ^11 || ^12",
    "squizlabs/php_codesniffer": "~3",
    "orchestra/testbench": "^6.48 || ^7 || ^8 || ^9 || ^10 || ^11",
    "guzzlehttp/guzzle": "^7.0",
    "php-http/guzzle7-adapter": "^1.0",
    "php-http/mock-client": "^1.6",
    "nyholm/psr7": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "Montross50\\UptimeRobotApi\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Montross50\\UptimeRobotApi\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "check-style": "phpcs -p --standard=PSR2 --runtime-set ignore_errors_on_exit 1 --runtime-set ignore_warnings_on_exit 1 src tests",
    "fix-style": "phpcbf -p --standard=PSR2 --runtime-set ignore_errors_on_exit 1 --runtime-set ignore_warnings_on_exit 1 src tests"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    },
    "laravel": {
      "providers": [
        "Montross50\\UptimeRobotApi\\UptimeRobotApiServiceProvider"
      ]
    }
  }
}
